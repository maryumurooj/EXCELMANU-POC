{
  "openapi": "3.0.4",
  "info": {
    "title": "ExcelDataManipulator.API",
    "version": "1.0"
  },
  "paths": {
    "/api/excel/upload": {
      "post": {
        "tags": [
          "StreamingExcel"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/excel/sessions/{sessionId}/operations": {
      "post": {
        "tags": [
          "StreamingExcel"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationCommand"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationCommand"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OperationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/excel/sessions/{sessionId}/summary": {
      "get": {
        "tags": [
          "StreamingExcel"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sheetName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/excel/sessions/{sessionId}/export": {
      "get": {
        "tags": [
          "StreamingExcel"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "excel"
            }
          },
          {
            "name": "allSheets",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/excel/sessions/{sessionId}": {
      "delete": {
        "tags": [
          "StreamingExcel"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OperationCommand": {
        "required": [
          "columnIndices",
          "operation",
          "sheetName"
        ],
        "type": "object",
        "properties": {
          "operation": {
            "minLength": 1,
            "type": "string"
          },
          "sheetName": {
            "minLength": 1,
            "type": "string"
          },
          "columnIndices": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": { },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}